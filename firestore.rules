rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      // Anyone who has loaded the page gets a silent, anonymous sign-in
      // (no login screen) — this just keeps it to actual visitors of the
      // app rather than the open internet.
      allow read, write: if request.auth != null;
    }
  }
}
